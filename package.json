{
  "name": "poisk-po-dokladam",
  "version": "1.0.0",
  "private": true,
  "description": "Поисковик по учебным презентациям однокурсников (статический сайт для GitHub Pages)",
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "serve": "node build/serve.mjs",
    "fixtures": "node tests/make-fixtures.mjs",
    "check-model": "node build/check-model.mjs",
    "test": "node build/build.mjs --input tests/fixtures --out _site-test && playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "minisearch": "7.2.0",
    "mupdf": "1.28.1",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
